# Copy to .env locally. Never commit real values.
NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (keep private)
MONGODB_URI=

# Authentication secret: generate a long random value
AUTH_SECRET=

# Optional integration credentials are configured server-side only.
# MIKROTIK_HOST=
# MIKROTIK_USERNAME=
# MIKROTIK_PASSWORD=
# GENIEACS_NBI_URL=
# GENIEACS_USERNAME=
# GENIEACS_PASSWORD=
