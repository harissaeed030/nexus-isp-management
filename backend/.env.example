# Local Android/Termux development
NODE_ENV=development
PORT=4000
SQLITE_PATH=./data/nexus.sqlite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Production example (set these in the host's environment/secret manager; do not commit real values)
# NODE_ENV=production
# PORT=4000
# SQLITE_PATH=/var/lib/nexus/nexus.sqlite
# SQLITE_BACKUP_DIR=/var/backups/nexus
# CORS_ORIGINS=https://app.example.com
