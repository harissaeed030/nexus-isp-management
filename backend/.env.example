PORT=4000
NODE_ENV=development
SQLITE_PATH=./data/nexus.sqlite
CORS_ORIGINS=http://localhost:4000
# Generate with: openssl rand -hex 32. Keep private and back up securely.
ROUTER_CREDENTIAL_KEY=
# Optional dedicated OLT key; falls back to ROUTER_CREDENTIAL_KEY when blank.
OLT_CREDENTIAL_KEY=
# Do not enable mock data in a production deployment.
NEXUS_ROUTER_ADAPTER=live
