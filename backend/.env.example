PORT=4000
NODE_ENV=development
SQLITE_PATH=./data/nexus.sqlite
CORS_ORIGINS=http://localhost:4000
# Generate with: openssl rand -hex 32. Keep private and back up securely.
ROUTER_CREDENTIAL_KEY=
# Optional dedicated OLT key; falls back to ROUTER_CREDENTIAL_KEY when blank.
OLT_CREDENTIAL_KEY=
# Do not enable mock data in a production deployment.
NEXUS_ROUTER_ADAPTER=live

# Generate with: openssl rand -hex 32. Required for TR-069 ACS credential encryption.
ACS_CREDENTIAL_KEY=

# Optional Meta WhatsApp Cloud API credentials. Keep these only in the server .env / secret store.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional monthly invoice generation at 05:15 Asia/Karachi on day 1.
# When enabled, missed runs are caught up after the first day; duplicate periods are prevented.
AUTO_BILLING_ENABLED=false

# Optional Gemini AI assistant. The key is server-only; never add it to frontend files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SQLite -> Cloudflare D1 sync. Generate independent random secrets; never commit real values.
# SYNC_TENANT_ID is the local tenants.id returned by GET /api/v1/tenant.
SYNC_TENANT_ID=
SYNC_EXPORT_TOKEN=
D1_SYNC_WORKER_URL=https://nexus-sqlite-sync.<your-subdomain>.workers.dev/sync/push
D1_SYNC_WORKER_TOKEN=
