NODE_ENV=development
PORT=4000
# Local SQLite database created automatically; do not commit the data directory.
SQLITE_PATH=./data/nexus.sqlite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Optional Gemini AI Assistant. Keep this key only on the backend; never put it in browser JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
