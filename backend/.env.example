PORT=4000
NODE_ENV=development
SQLITE_PATH=./data/nexus.sqlite
CORS_ORIGINS=http://localhost:4000
# Generate with: openssl rand -hex 32. Keep private and back up securely.
ROUTER_CREDENTIAL_KEY=
# Optional dedicated OLT key; falls back to ROUTER_CREDENTIAL_KEY when blank.
OLT_CREDENTIAL_KEY=
# Do not enable mock data in a production deployment.
NEXUS_ROUTER_ADAPTER=live

# Generate with: openssl rand -hex 32. Required for TR-069 ACS credential encryption.
ACS_CREDENTIAL_KEY=

# Optional Meta WhatsApp Cloud API credentials. Keep these only in the server .env / secret store.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
