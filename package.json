{
  "name": "nexus-isp-management-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android wrapper for the NEXUS ISP Management web app",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "android:release": "cd android && ./gradlew assembleRelease",
    "build:android": "npm run mobile:prepare && npm run android:sync && npm run android:build",
    "mobile:prepare": "node scripts/prepare-mobile.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
